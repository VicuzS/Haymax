{
  "expo": {
    "name": "Haymax",
    "slug": "haymax-app",
    "version": "1.0.0",
    "scheme": "haymax",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Haymax usa la cámara para leer boletas y listas de compras.",
          "photosPermission": "Haymax permite seleccionar imágenes de boletas y listas.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
